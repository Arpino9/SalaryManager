<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ViewModels="clr-namespace:SalaryManager.Prism.ViewModels"
        x:Class="SalaryManager.Prism.Views.ImageViewer"
        Title="イメージビューアー"
        WindowStartupLocation="CenterScreen">
    <Window.DataContext>
        <ViewModels:ImageViewerViewModel/>
    </Window.DataContext>
    <Grid>
        <Image Source="{Binding FileImage_Image}"/>
    </Grid>
</Window>
