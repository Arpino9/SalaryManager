<UserControl x:Class="SalaryManager.Prism.Views.UserControl.SideBusiness"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"             
             xmlns:ViewModels="clr-namespace:SalaryManager.Prism.ViewModels" 
             prism:ViewModelLocator.AutoWireViewModel="True"
             xmlns:behaviors="http://schemas.microsoft.com/xaml/behaviors"
             Height="200" Width="300"
             Background="{x:Static SystemColors.ControlLightBrush}">
    <Grid>
        <Grid.DataContext>
            <ViewModels:SideBusinessViewModel/>
        </Grid.DataContext>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="90" />
            <ColumnDefinition />
            <ColumnDefinition Width="90" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition />
            <RowDefinition Height="70" />
        </Grid.RowDefinitions>

        <Label Content="副業" 
           Style="{StaticResource PayslipItemLabel_Style}" />
        <TextBox Grid.Column="1" 
             Style="{StaticResource PayslipItemNumeric_Style}" 
             Text="{Binding SideBusiness_Text, StringFormat={}{0:N0}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" >

            <behaviors:Interaction.Triggers>
                <behaviors:EventTrigger EventName="MouseMove">
                    <behaviors:InvokeCommandAction Command="{Binding SideBusiness_MouseMove}" />
                </behaviors:EventTrigger>

                <behaviors:EventTrigger EventName="MouseLeave">
                    <behaviors:InvokeCommandAction Command="{Binding Default_MouseLeave}" />
                </behaviors:EventTrigger>
            </behaviors:Interaction.Triggers>
        </TextBox>

        <Label Content="臨時収入" 
           Grid.Row="1" 
           Style="{StaticResource PayslipItemLabel_Style}" />
        <TextBox Grid.Column="1" 
             Grid.Row="1" 
             Style="{StaticResource PayslipItemNumeric_Style}" 
             Text="{Binding Perquisite_Text, StringFormat={}{0:N0}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" >

            <behaviors:Interaction.Triggers>
                <behaviors:EventTrigger EventName="MouseMove">
                    <behaviors:InvokeCommandAction Command="{Binding Perquisite_MouseMove}" />
                </behaviors:EventTrigger>

                <behaviors:EventTrigger EventName="MouseLeave">
                    <behaviors:InvokeCommandAction Command="{Binding Default_MouseLeave}" />
                </behaviors:EventTrigger>
            </behaviors:Interaction.Triggers>
        </TextBox>

        <Label Content="その他" 
           Grid.Column="2" 
           Style="{StaticResource PayslipItemLabel_Style}" />
        <TextBox Grid.Column="3" 
             Style="{StaticResource PayslipItemNumeric_Style}" 
             Text="{Binding Others_Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" >

            <behaviors:Interaction.Triggers>
                <behaviors:EventTrigger EventName="MouseMove">
                    <behaviors:InvokeCommandAction Command="{Binding Others_MouseMove}" />
                </behaviors:EventTrigger>

                <behaviors:EventTrigger EventName="MouseLeave">
                    <behaviors:InvokeCommandAction Command="{Binding Default_MouseLeave}" />
                </behaviors:EventTrigger>
            </behaviors:Interaction.Triggers>
        </TextBox>

        <Label Content="備考" 
           Grid.Row="2"
           Style="{StaticResource PayslipItemLabel_Style}" />
        <TextBox Grid.Column="1"
             Grid.ColumnSpan="3"
             Grid.Row="2" 
             AcceptsReturn="True"
             Style="{StaticResource PayslipItemCharacter_Style}"
             Text="{Binding Remarks_Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
             TextWrapping="Wrap" />
    </Grid>
</UserControl>
