<Controls:MetroWindow
        x:Class="SalaryManager.WPF.Window.Project"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SalaryManager.WPF.Window"
        xmlns:Controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
        xmlns:ViewModels="clr-namespace:SalaryManager.WPF.ViewModels"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:behaviors="http://schemas.microsoft.com/xaml/behaviors"
        mc:Ignorable="d"
        Title="{Binding Window_Title.Value, Mode=OneWay}" Height="700" Width="800"
        Background="{Binding Window_Background.Value}"
        FontFamily="{Binding Window_FontFamily.Value}"
        FontSize="{Binding Window_FontSize.Value}">
	<Window.DataContext>
		<ViewModels:ViewModel_Project/>
	</Window.DataContext>
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="100" />
			<RowDefinition />
		</Grid.RowDefinitions>

		<ListView ItemsSource="{Binding Projects_ItemSource}"
			  	  SelectedIndex="{Binding Projects_SelectedIndex.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
				  ScrollViewer.HorizontalScrollBarVisibility="Auto">
			<behaviors:Interaction.Triggers>
				<behaviors:EventTrigger EventName="SelectionChanged">
					<behaviors:InvokeCommandAction Command="{Binding Projects_SelectionChanged}" />
				</behaviors:EventTrigger>
			</behaviors:Interaction.Triggers>
			<ListView.View>
				<GridView>
					<GridViewColumn DisplayMemberBinding="{Binding ProjectName}">
						<GridViewColumnHeader Content="プロジェクト名"/>
					</GridViewColumn>

					<GridViewColumn DisplayMemberBinding="{Binding StartDate}">
						<GridViewColumnHeader Content="開始日" />
					</GridViewColumn>

					<GridViewColumn DisplayMemberBinding="{Binding EndDate}">
						<GridViewColumnHeader Content="終了日"/>
					</GridViewColumn>

					<GridViewColumn DisplayMemberBinding="{Binding SystemName}">
						<GridViewColumnHeader Content="システム名"/>
					</GridViewColumn>
				</GridView>
			</ListView.View>
		</ListView>

		<Grid Grid.Row="1">
			<Grid.ColumnDefinitions>
				<ColumnDefinition />
				<ColumnDefinition />
				<ColumnDefinition />
				<ColumnDefinition />
			</Grid.ColumnDefinitions>
			<Grid.RowDefinitions>
				<RowDefinition />
				<RowDefinition />
				<RowDefinition />
				<RowDefinition />
				<RowDefinition />
				<RowDefinition />
				<RowDefinition />
				<RowDefinition />
				<RowDefinition />
				<RowDefinition />
				<RowDefinition Height="50" />
				<RowDefinition Height="100" />
				<RowDefinition />
				<RowDefinition />
			</Grid.RowDefinitions>

			<Label Content="プロジェクト名"
					Style="{DynamicResource MahApps.Styles.Label}"
					Background="AliceBlue"/>
			<TextBox Text="{Binding ProjectName_Text.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
					Grid.Column="1"
					Background="AliceBlue">
				<behaviors:Interaction.Triggers>
					<behaviors:EventTrigger EventName="TextChanged">
						<behaviors:InvokeCommandAction Command="{Binding ProjectName_TextChanged}" />
					</behaviors:EventTrigger>
				</behaviors:Interaction.Triggers>
			</TextBox>

			<Label Content="プロジェクト期間"
					Grid.Row="1"
					Grid.RowSpan="1"
					Style="{DynamicResource MahApps.Styles.Label}"
					Background="AliceBlue"/>
			<DatePicker Grid.Column="1"
						Grid.Row="1"
						Style="{DynamicResource MahApps.Styles.DatePicker}"
						SelectedDate="{Binding StartDate_SelectedDate.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
			<Label Content="～"
					Grid.Column="2"
					Grid.Row="1"
					Style="{DynamicResource MahApps.Styles.Label}"
					HorizontalAlignment="Center"
					VerticalAlignment="Center" />
			<DatePicker Grid.Column="3"
						Grid.Row="1"
						Style="{DynamicResource MahApps.Styles.DatePicker}"
						SelectedDate="{Binding EndDate_SelectedDate.Value}"
						IsEnabled="{Binding EndDate_IsEnabled.Value}" />
			<CheckBox Content="進行中"
						Grid.Column="3"
						Grid.Row="2"
						Style="{DynamicResource MahApps.Styles.CheckBox}"
						IsChecked="{Binding Ongoing_IsChecked.Value}">
				<behaviors:Interaction.Triggers>
					<behaviors:EventTrigger EventName="Checked">
						<behaviors:InvokeCommandAction Command="{Binding Ongoing_Checked}" />
					</behaviors:EventTrigger>

					<behaviors:EventTrigger EventName="Unchecked">
						<behaviors:InvokeCommandAction Command="{Binding Ongoing_Checked}" />
					</behaviors:EventTrigger>
				</behaviors:Interaction.Triggers>
			</CheckBox>

				
			<Label Content="システム名"
					Grid.Row="3"
					Style="{DynamicResource MahApps.Styles.Label}"
					Background="AliceBlue"/>
			<TextBox Grid.Column="1"
						Grid.Row="3"
						Grid.ColumnSpan="3"
						Style="{DynamicResource MahApps.Styles.TextBox}"
						Text="{Binding SystemName_Text.Value}" />

			<Label Content="言語"
					Grid.Row="4"
					Style="{DynamicResource MahApps.Styles.Label}"
					Background="AliceBlue"/>
			<TextBox Grid.Column="1"
						Grid.Row="4"
						Grid.ColumnSpan="3"
						Style="{DynamicResource MahApps.Styles.TextBox}"
						Text="{Binding Language_Text.Value}" />

			<Label Content="データベース"
					Grid.Row="5"
					Style="{DynamicResource MahApps.Styles.Label}"
					Background="AliceBlue"/>
			<TextBox Grid.Column="1"
						Grid.Row="5"
						Grid.ColumnSpan="3"
						Style="{DynamicResource MahApps.Styles.TextBox}"
						Text="{Binding Database_Text.Value}" />

			<Label Content="開発支援ツール"
					Grid.Row="6"
					Style="{DynamicResource MahApps.Styles.Label}"
					Background="AliceBlue"/>
			<TextBox Grid.Column="1"
						Grid.Row="6"
						Grid.ColumnSpan="3"
						Style="{DynamicResource MahApps.Styles.TextBox}"
						Text="{Binding DevelopmentSupporting_Text.Value}" />

			<Label Content="その他ツール"
					Grid.Row="7"
					Style="{DynamicResource MahApps.Styles.Label}"
					Background="AliceBlue"/>
			<TextBox Grid.Column="1"
						Grid.Row="7"
						Grid.ColumnSpan="3"
						Style="{DynamicResource MahApps.Styles.TextBox}"
						Text="{Binding OtherTools_Text.Value}" />

			<Label Content="担当役割"
					Grid.Row="8"
					Style="{DynamicResource MahApps.Styles.Label}"
					Background="AliceBlue"/>
			<TextBox Grid.Column="1"
						Grid.Row="8"
						Grid.ColumnSpan="3"
						Style="{DynamicResource MahApps.Styles.TextBox}"
						Text="{Binding Role_Text.Value}" />

			<Label Content="メンバー数"
					Grid.Row="9"
					Style="{DynamicResource MahApps.Styles.Label}"
					Background="AliceBlue"/>
			<TextBox Grid.Column="1"
						Grid.Row="9"
						Grid.ColumnSpan="3"
						Style="{DynamicResource MahApps.Styles.TextBox}"
						Text="{Binding Member_Text.Value}" />

			<Label Content="担当工程"
                Grid.Row="10"
                Style="{DynamicResource MahApps.Styles.Label}"
                Background="AliceBlue"/>
			<ScrollViewer Grid.Column="1"
							Grid.Row="10"
							Style="{DynamicResource MahApps.Styles.ScrollViewer}"
							Width="150">
				<StackPanel>
					<CheckBox Content="要件定義" IsChecked="{Binding AssignedPhrase_RequireDefinition_IsChecked.Value}" Style="{DynamicResource MahApps.Styles.CheckBox}" />
					<CheckBox Content="基本設計" IsChecked="{Binding AssignedPhrase_BasicDesign_IsChecked.Value}" Style="{DynamicResource MahApps.Styles.CheckBox}" />
					<CheckBox Content="詳細設計" IsChecked="{Binding AssignedPhrase_DetailDesign_IsChecked.Value}" Style="{DynamicResource MahApps.Styles.CheckBox}" />
					<CheckBox Content="開発" IsChecked="{Binding AssignedPhrase_Development_IsChecked.Value}" Style="{DynamicResource MahApps.Styles.CheckBox}" />
					<CheckBox Content="単体テスト" IsChecked="{Binding AssignedPhrase_UnitTest_IsChecked.Value}" Style="{DynamicResource MahApps.Styles.CheckBox}" />
					<CheckBox Content="結合テスト" IsChecked="{Binding AssignedPhrase_IntegrationTest_IsChecked.Value}" Style="{DynamicResource MahApps.Styles.CheckBox}" />
					<CheckBox Content="システムテスト" IsChecked="{Binding AssignedPhrase_SystemTest_IsChecked.Value}" Style="{DynamicResource MahApps.Styles.CheckBox}" />
					<CheckBox Content="運用テスト" IsChecked="{Binding AssignedPhrase_OperationTest_IsChecked.Value}" Style="{DynamicResource MahApps.Styles.CheckBox}" />
					<CheckBox Content="その他" IsChecked="{Binding AssignedPhrase_Other_IsChecked.Value}" Style="{DynamicResource MahApps.Styles.CheckBox}" />
				</StackPanel>
			</ScrollViewer>

			<Label Content="業務詳細"
					Grid.Row="11"
					Style="{DynamicResource MahApps.Styles.Label}"
					Background="AliceBlue"/>
			<TextBox Grid.Column="1"
						Grid.Row="11"
						Grid.ColumnSpan="3"
						AcceptsReturn="True"
	                    TextWrapping="Wrap"
						Style="{DynamicResource MahApps.Styles.TextBox}"
						Text="{Binding Contents_Text.Value}" />

			<Label Content="備考"
					Grid.Row="12"
					Style="{DynamicResource MahApps.Styles.Label}"
					Background="AliceBlue" />
			<TextBox Grid.Column="1"
					 Grid.Row="12"
					 Grid.ColumnSpan="3"
					 Style="{DynamicResource MahApps.Styles.TextBox}"
					 Text="{Binding Remarks_Text.Value}" 
					 TextWrapping="Wrap" />

			<Button Grid.Row="13"
					Command="{Binding Add_Command}"
					Style="{DynamicResource MahApps.Styles.Button}"
					IsEnabled="{Binding Add_IsEnabled.Value}">
				<StackPanel Orientation="Horizontal">
					<iconPacks:PackIconMaterial Kind="ArrowExpandUp" Width="16" Height="16" Margin="0,0,5,0"/>
					<TextBlock Text="追加"/>
				</StackPanel>
			</Button>
			<Button Grid.Row="13"
					Grid.Column="1"
					Grid.ColumnSpan="2"
					Style="{DynamicResource MahApps.Styles.Button}"
					Command="{Binding Update_Command}"
					IsEnabled="{Binding Update_IsEnabled.Value}">
				<StackPanel Orientation="Horizontal">
					<iconPacks:PackIconMaterial Kind="Autorenew" Width="16" Height="16" Margin="0,0,5,0"/>
					<TextBlock Text="更新"/>
				</StackPanel>
			</Button>
			<Button Grid.Column="3"
					Grid.Row="13"
					Style="{DynamicResource MahApps.Styles.Button}"
					Command="{Binding Delete_Command}"
					IsEnabled="{Binding Delete_IsEnabled.Value}">
				<StackPanel Orientation="Horizontal">
					<iconPacks:PackIconMaterial Kind="TrashCan" Width="16" Height="16" Margin="0,0,5,0"/>
					<TextBlock Text="削除"/>
				</StackPanel>
			</Button>
		</Grid>
    </Grid>
</Controls:MetroWindow>
