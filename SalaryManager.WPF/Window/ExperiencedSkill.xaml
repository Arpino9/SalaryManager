<Controls:MetroWindow 
             x:Class="SalaryManager.WPF.Window.ExperiencedSkill"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SalaryManager.WPF.Window"
             xmlns:Controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
             xmlns:ViewModels="clr-namespace:SalaryManager.WPF.ViewModels" 
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:behaviors="http://schemas.microsoft.com/xaml/behaviors"
             Title="{Binding Window_Title.Value}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Controls:MetroWindow.DataContext>
        <ViewModels:ViewModel_ExperiencedSkill/>
    </Controls:MetroWindow.DataContext>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
        </Grid.RowDefinitions>

        <Grid>
            <ListView ItemsSource="{Binding ExperiencedLanguages_ItemSource}" 
                      Style="{DynamicResource MahApps.Styles.ListView}"
                      Height="150"
                      SelectedIndex="{Binding ExperiencedLanguages_SelectedIndex.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <ListView.View>
                    <GridView>
                        <GridViewColumn DisplayMemberBinding="{Binding Language}">
                            <GridViewColumnHeader Content="言語" />
                        </GridViewColumn>

                        <GridViewColumn DisplayMemberBinding="{Binding Year}">
                            <GridViewColumnHeader Content="経験年数" />
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Grid>

        <Grid Grid.Row="1" Height="150">
            <ListView ItemsSource="{Binding ExperiencedDatabases_ItemSource}" 
                      Style="{DynamicResource MahApps.Styles.ListView}"
                      SelectedIndex="{Binding ExperiencedDatabases_SelectedIndex.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <ListView.View>
                    <GridView>
                        <GridViewColumn DisplayMemberBinding="{Binding Database}">
                            <GridViewColumnHeader Content="DB" />
                        </GridViewColumn>

                        <GridViewColumn DisplayMemberBinding="{Binding Year}">
                            <GridViewColumnHeader Content="経験年数" />
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Grid>

        <Grid Grid.Row="2" Height="150">
            <ListView ItemsSource="{Binding ExperiencedDevelopmentSupportingTools_ItemSource}" 
                      Style="{DynamicResource MahApps.Styles.ListView}"
                      SelectedIndex="{Binding ExperiencedDevelopmentSupportingTools_SelectedIndex.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <ListView.View>
                    <GridView>
                        <GridViewColumn DisplayMemberBinding="{Binding Tool}">
                            <GridViewColumnHeader Content="ツール" />
                        </GridViewColumn>

                        <GridViewColumn DisplayMemberBinding="{Binding Year}">
                            <GridViewColumnHeader Content="経験年数" />
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Grid>

        <Grid Grid.Row="3" Height="150">
            <ListView ItemsSource="{Binding ExperiencedOtherTools_ItemSource}" 
              Style="{DynamicResource MahApps.Styles.ListView}"
              SelectedIndex="{Binding ExperiencedOtherTools_SelectedIndex.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
              ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <ListView.View>
                    <GridView>
                        <GridViewColumn DisplayMemberBinding="{Binding Tool}">
                            <GridViewColumnHeader Content="ツール" />
                        </GridViewColumn>

                        <GridViewColumn DisplayMemberBinding="{Binding Year}">
                            <GridViewColumnHeader Content="経験年数" />
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Grid>
    </Grid>
</Controls:MetroWindow>
